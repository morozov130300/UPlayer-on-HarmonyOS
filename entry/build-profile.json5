{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DOHOS_STL=c++_static",
      "cppFlags": "-std=c++17"
    },
    // strip 掉 so 的调试信息与符号表，减小 libuplayer.so 体积（debug/release 均生效）
    "nativeLib": {
      "debugSymbol": {
        "strip": true
      }
    },
    "arkOptions": {
      "runtimeOnly": {
        "packages": [
          "libuplayer.so"
        ]
      }
    },
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": true,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}
